import re
from typing import TypedDict, Literal, Optional
from langgraph.graph import StateGraph, END
import requests

# Define the state structure
class AgentState(TypedDict):
    user_input: str
    client_name: Optional[str]
    portfolio_trades: Optional[list]
    selected_trade_id: Optional[str]
    current_step: Literal["init", "need_client", "need_trade", "executing", "complete"]
    response: str
    error: Optional[str]

# Regex patterns for intent matching
PATTERNS = {
    "tickerize": re.compile(r'\b(tickerize|ticker|tick)\b', re.IGNORECASE),
    "client_name": re.compile(r'\b(?:client|for)\s+([A-Za-z0-9_\-]+)\b', re.IGNORECASE),
    "trade_selection": re.compile(r'\b(?:trade|pt|portfolio\s*trade)?\s*#?(\d+)\b', re.IGNORECASE),
    "number_only": re.compile(r'^(\d+)$'),
}

def extract_client_name(text: str) -> Optional[str]:
    """Extract client name from user input"""
    match = PATTERNS["client_name"].search(text)
    if match:
        return match.group(1)
    return None

def extract_trade_id(text: str) -> Optional[str]:
    """Extract trade ID/number from user input"""
    # Try specific pattern first
    match = PATTERNS["trade_selection"].search(text)
    if match:
        return match.group(1)
    
    # Fall back to just a number
    match = PATTERNS["number_only"].search(text.strip())
    if match:
        return match.group(1)
    
    return None

def is_tickerize_intent(text: str) -> bool:
    """Check if user wants to tickerize"""
    return bool(PATTERNS["tickerize"].search(text))

